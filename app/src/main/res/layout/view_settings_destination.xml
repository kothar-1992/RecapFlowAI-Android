<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/rf_screen_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/rf_screen_padding"
    android:paddingBottom="36dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.RecapFlow.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/settings_subtitle"
        android:textAppearance="@style/TextAppearance.RecapFlow.Body" />

    <com.recapflow.ai.ui.LanguageSettingsView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_processing_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_processing_value"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/rf_success" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_processing_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/rf_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_editor_preferences_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_editor_preferences_description"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settingsAutoRestoreSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_auto_restore" />

            <TextView
                android:id="@+id/settingsEditorPreferencesStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_editor_preferences_status_default"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsSavePresetButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_save_preset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsRestorePresetButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_restore_preset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsRestoreLastSessionButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_restore_last_session" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsResetCurrentSectionButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_reset_current_section" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsResetAllButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_reset_all" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_profile_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_device_profile_description"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />

            <TextView
                android:id="@+id/settingsDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/device_checking"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsDeviceType"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/rf_on_surface_variant" />

            <TextView
                android:id="@+id/settingsCapabilityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/rf_primary_container"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/rf_on_primary_container" />

            <TextView
                android:id="@+id/settingsScreenValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsCpuValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsMemoryValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsStorageValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsNetworkValue"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/rf_surface_variant"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:id="@+id/settingsEngineStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_checking"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/settingsEngineStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/native_status_checking"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/settings_future_note"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/rf_on_surface_variant" />
</LinearLayout>
