<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/rf_screen_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/rf_screen_padding"
    android:paddingBottom="36dp">

    <com.google.android.material.chip.Chip
        style="@style/Widget.Material3.Chip.Assist.Elevated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:text="@string/on_device_badge"
        android:textColor="@color/rf_on_primary_container"
        app:chipBackgroundColor="@color/rf_primary_container" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/home_title"
        android:textAppearance="@style/TextAppearance.RecapFlow.Headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/home_tab_subtitle"
        android:textAppearance="@style/TextAppearance.RecapFlow.Body" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeActiveProjectCard"
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_active_project"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/rf_primary" />

            <TextView
                android:id="@+id/homeActiveFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="middle"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.RecapFlow.Title" />

            <TextView
                android:id="@+id/homeActiveFileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/rf_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeContinueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="48dp"
                android:text="@string/continue_editing" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeChooseAnotherButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/choose_another_video" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/homeImportCard"
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/rf_primary_container"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/rf_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_import_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/rf_on_primary_container" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_import_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/rf_on_primary_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homeImportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="52dp"
                android:text="@string/import_video" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.RecapFlow.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/rf_surface_variant"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/homeEngineStatusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_checking"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/homeEngineStatusDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/native_status_checking"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
