<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clipTransitionCard"
    style="@style/Widget.RecapFlow.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    app:cardBackgroundColor="@color/rf_surface"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clip_transition_badge"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/rf_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/clip_transition_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/rf_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/clip_transition_description"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/rf_on_surface_variant" />

        <TextView
            android:id="@+id/clipTransitionUnavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/clip_transition_unavailable"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/rf_on_surface_variant" />

        <LinearLayout
            android:id="@+id/clipTransitionAvailableGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/clipTransitionBoundaryValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/rf_on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipTransitionPreviousButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/clip_transition_previous" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipTransitionNextButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/clip_transition_next" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/clipTransitionEnabledSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/clip_transition_enable"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/rf_on_surface" />

            <TextView
                android:id="@+id/clipTransitionSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/clip_transition_off_summary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/clip_transition_duration"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/rf_on_surface" />

            <com.google.android.material.slider.Slider
                android:id="@+id/clipTransitionDurationSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="50"
                android:value="300"
                android:valueFrom="150"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/clipTransitionDurationValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clip_transition_duration_value"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/rf_on_surface_variant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/clip_transition_easing"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/rf_on_surface" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/clipTransitionEasingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipTransitionLinearButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:text="@string/clip_transition_linear" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clipTransitionEaseButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:text="@string/clip_transition_ease_in_out" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clipTransitionPreviewButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/clip_transition_preview" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clipTransitionResetButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="48dp"
                android:text="@string/clip_transition_reset" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
