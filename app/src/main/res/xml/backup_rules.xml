<?xml version="1.0" encoding="utf-8"?><!--
   Pre-Android-12 counterpart to data_extraction_rules.xml. The manifest sets
   android:fullBackupContent="false", which disables backup outright, so this file is not reached
   today. It is written to the safe behaviour anyway so that re-enabling backup later cannot
   silently start shipping the user's local file metadata off the device.

   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
</full-backup-content>
