<?xml version="1.0" encoding="utf-8"?><!--
   RecapFlowAI is a local-first editor. It holds no server-side account, and its stored state is
   editor preferences plus working-file metadata for media the user already owns on the device.
   Backing that up or transferring it would leak the user's local file layout to a cloud account
   or another device, so everything is excluded on both paths.

   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
